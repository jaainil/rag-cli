# PostgreSQL Database with pgvector
DATABASE_URL=postgres://user:password@hostname:3060/postgres

# Dragonfly / Redis Cache Store
REDIS_URL=redis://:password@hostname:3006/0

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:9b
OLLAMA_DEEP_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_RERANK_MODEL=pdurugyan/qwen3-reranker-0.6b-q8_0:latest

# LLM Provider Choice ('ollama' | 'anthropic' | 'openai' | 'offline')
LLM_PROVIDER=ollama

# Optional Cloud LLM Keys (if not using local Ollama)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
